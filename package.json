{
  "name": "truesquare",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "node --env-file=.env.local scripts/apply-pending-migrations.mjs",
    "db:seed": "node scripts/seed-registered-transactions.mjs",
    "db:seed:atlas": "node scripts/seed-atlas-projects.mjs",
    "db:seed:atlas:workbook-only": "node scripts/seed-atlas-workbook-only-projects.mjs",
    "db:classify:atlas-developers": "node scripts/classify-atlas-developers.mjs",
    "db:coordinates:atlas": "node scripts/fetch-atlas-project-coordinates.mjs --include-osm",
    "test:transaction-import": "node --experimental-strip-types --test test/transaction-import.test.ts",
    "test:evidence-stack": "node --experimental-strip-types --test test/evidence-stack.test.ts",
    "test:valuation": "node --experimental-strip-types --test test/valuation-engine.test.ts",
    "test:society-evidence": "node --experimental-strip-types --test test/society-evidence.test.ts",
    "test:share-tracking": "node --experimental-strip-types --test test/share-tracking.test.ts",
    "test:analytics": "node --experimental-strip-types --test test/analytics.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "fflate": "^0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
